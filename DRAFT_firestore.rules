rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'jayarajyadav2006@gmail.com' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'authProvider', 'accountStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'authProvider', 'accountStatus', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.authProvider in ['google', 'demo']
        && data.accountStatus in ['ACTIVE', 'SUSPENDED']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll(['userId', 'fullName', 'preferredStartInr', 'preferredIncrementInr', 'kycSimulationStatus', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'fullName', 'phoneMasked', 'city', 'state', 'preferredStartInr', 'preferredIncrementInr', 'preferredUpiApp', 'preferredUpiVpaMasked', 'kycSimulationStatus', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && (!('phoneMasked' in data) || (data.phoneMasked is string && data.phoneMasked.size() <= 20))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('state' in data) || (data.state is string && data.state.size() <= 80))
        && data.preferredStartInr is number && data.preferredStartInr >= 10 && data.preferredStartInr <= 10000
        && data.preferredIncrementInr is number && data.preferredIncrementInr >= 5 && data.preferredIncrementInr <= 5000
        && (!('preferredUpiApp' in data) || data.preferredUpiApp in ['GPAY', 'PHONEPE', 'PAYTM', 'BHIM', 'AMAZON_PAY', 'OTHER_UPI'])
        && (!('preferredUpiVpaMasked' in data) || (data.preferredUpiVpaMasked is string && data.preferredUpiVpaMasked.size() <= 80))
        && data.kycSimulationStatus in ['SIMULATED_PENDING', 'SIMULATED_VERIFIED']
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidChallenge(data, challengeId) {
      return data.keys().hasAll(['id', 'userId', 'planCode', 'durationDays', 'illustrativeBonusRate', 'startAmountInr', 'incrementAmountInr', 'totalPlannedInr', 'totalSavedInr', 'completedDays', 'status', 'locked', 'simulatedMode', 'startDate', 'nextDueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'planCode', 'durationDays', 'illustrativeBonusRate', 'startAmountInr', 'incrementAmountInr', 'totalPlannedInr', 'totalSavedInr', 'completedDays', 'status', 'locked', 'simulatedMode', 'startDate', 'nextDueDate', 'failedReason', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == challengeId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.planCode in ['1D_0PCT', '49D_2PCT', '99D_4PCT', '299D_5PCT', '364D_8PCT']
        && data.durationDays in [1, 49, 99, 299, 364]
        && data.illustrativeBonusRate in [0, 2, 4, 5, 8]
        && data.startAmountInr is number && data.startAmountInr >= 10 && data.startAmountInr <= 10000
        && data.incrementAmountInr is number && data.incrementAmountInr >= 5 && data.incrementAmountInr <= 5000
        && data.totalPlannedInr is number && data.totalPlannedInr > 0
        && data.totalSavedInr is number && data.totalSavedInr >= 0
        && data.completedDays is int && data.completedDays >= 0 && data.completedDays <= data.durationDays
        && data.status in ['ACTIVE', 'COMPLETED', 'FAILED']
        && data.locked is bool
        && data.simulatedMode is bool && data.simulatedMode == true
        && data.startDate is string && data.startDate.size() <= 20
        && data.nextDueDate is string && data.nextDueDate.size() <= 20
        && (!('failedReason' in data) || (data.failedReason is string && data.failedReason.size() <= 240))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDailyContribution(data, contributionId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'dayNumber', 'scheduledDate', 'amountInr', 'status', 'referenceCode', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'challengeId', 'dayNumber', 'scheduledDate', 'amountInr', 'status', 'referenceCode', 'upiApp', 'upiVpaMasked', 'createdAt'])
        && data.id is string && data.id == contributionId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.challengeId is string && isValidId(data.challengeId)
        && data.dayNumber is int && data.dayNumber >= 1 && data.dayNumber <= 364
        && data.scheduledDate is string && data.scheduledDate.size() <= 20
        && data.amountInr is number && data.amountInr > 0
        && data.status in ['PAID_SIMULATED', 'MISSED']
        && data.referenceCode is string && data.referenceCode.size() >= 3 && data.referenceCode.size() <= 64
        && (!('upiApp' in data) || data.upiApp in ['GPAY', 'PHONEPE', 'PAYTM', 'BHIM', 'AMAZON_PAY', 'OTHER_UPI'])
        && (!('upiVpaMasked' in data) || (data.upiVpaMasked is string && data.upiVpaMasked.size() <= 80))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidStreak(data, streakId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'currentStreak', 'longestStreak', 'streakBroken', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'challengeId', 'currentStreak', 'longestStreak', 'lastContributionDate', 'streakBroken', 'updatedAt'])
        && data.id is string && data.id == streakId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.challengeId is string && isValidId(data.challengeId)
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 364
        && data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 364
        && (!('lastContributionDate' in data) || (data.lastContributionDate is string && data.lastContributionDate.size() <= 20))
        && data.streakBroken is bool
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTransaction(data, txId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'txType', 'amountInr', 'simulated', 'referenceId', 'reconciliationStatus', 'description', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'challengeId', 'txType', 'amountInr', 'simulated', 'referenceId', 'reconciliationStatus', 'upiApp', 'upiVpaMasked', 'description', 'createdAt'])
        && data.id is string && data.id == txId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.challengeId is string && isValidId(data.challengeId)
        && data.txType in ['SIMULATED_DEPOSIT', 'RESTRICTED_HOLD_TRANSFER', 'ILLUSTRATIVE_BONUS_CREDIT', 'APPROVED_REFUND_SETTLEMENT']
        && data.amountInr is number && data.amountInr >= 0
        && data.simulated is bool && data.simulated == true
        && data.referenceId is string && data.referenceId.size() >= 3 && data.referenceId.size() <= 64
        && data.reconciliationStatus in ['RECONCILED', 'PENDING_REVIEW']
        && (!('upiApp' in data) || data.upiApp in ['GPAY', 'PHONEPE', 'PAYTM', 'BHIM', 'AMAZON_PAY', 'OTHER_UPI'])
        && (!('upiVpaMasked' in data) || (data.upiVpaMasked is string && data.upiVpaMasked.size() <= 80))
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 240
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidRestrictedLedger(data, ledgerId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'principalBalanceInr', 'ownershipStatus', 'forfeitureProhibited', 'adminSpendProhibited', 'legalPartnerReviewStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'challengeId', 'principalBalanceInr', 'ownershipStatus', 'forfeitureProhibited', 'adminSpendProhibited', 'legalPartnerReviewStatus', 'reconciliationNote', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == ledgerId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.challengeId is string && isValidId(data.challengeId)
        && data.principalBalanceInr is number && data.principalBalanceInr >= 0
        && data.ownershipStatus in ['USER_OWNED_RESTRICTED', 'SETTLED_TO_USER']
        && data.forfeitureProhibited is bool && data.forfeitureProhibited == true
        && data.adminSpendProhibited is bool && data.adminSpendProhibited == true
        && data.legalPartnerReviewStatus in ['PENDING_LEGAL_PARTNER_REVIEW', 'APPROVED_FOR_SETTLEMENT', 'SETTLED']
        && (!('reconciliationNote' in data) || (data.reconciliationNote is string && data.reconciliationNote.size() <= 300))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSettlementRequest(data, settlementId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'ledgerId', 'amountInr', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'challengeId', 'ledgerId', 'amountInr', 'status', 'legalApprovalRef', 'partnerBankRef', 'transactionRef', 'approvedBy', 'createdAt', 'settledAt'])
        && data.id is string && data.id == settlementId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.challengeId is string && isValidId(data.challengeId)
        && data.ledgerId is string && isValidId(data.ledgerId)
        && data.amountInr is number && data.amountInr >= 0
        && data.status in ['PENDING_LEGAL_PARTNER_REVIEW', 'PARTNER_APPROVED', 'SETTLED_REFUNDED']
        && (!('legalApprovalRef' in data) || (data.legalApprovalRef is string && data.legalApprovalRef.size() <= 100))
        && (!('partnerBankRef' in data) || (data.partnerBankRef is string && data.partnerBankRef.size() <= 100))
        && (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 100))
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 120))
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('settledAt' in data) || (data.settledAt is string && data.settledAt.size() <= 64));
    }

    function isValidRewardRecord(data, rewardId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'eligibleSavingsInr', 'bonusRatePct', 'bonusAmountInr', 'illustrativeOnly', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'challengeId', 'eligibleSavingsInr', 'bonusRatePct', 'bonusAmountInr', 'illustrativeOnly', 'status', 'createdAt'])
        && data.id is string && data.id == rewardId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.challengeId is string && isValidId(data.challengeId)
        && data.eligibleSavingsInr is number && data.eligibleSavingsInr >= 0
        && data.bonusRatePct in [2, 4, 5, 8]
        && data.bonusAmountInr is number && data.bonusAmountInr >= 0
        && data.illustrativeOnly is bool && data.illustrativeOnly == true
        && data.status in ['PROPOSED_ILLUSTRATIVE', 'CREDITED_SIMULATED']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidNotification(data, notifId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'message', 'category', 'read', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'message', 'category', 'read', 'createdAt'])
        && data.id is string && data.id == notifId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 400
        && data.category in ['DEPOSIT', 'STREAK', 'CHALLENGE_FAILED', 'SETTLEMENT', 'REWARD']
        && data.read is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidAdminUser(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'active', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'active', 'createdAt'])
        && data.uid is string && data.uid == adminUid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role in ['COMPLIANCE_ADMIN', 'RECONCILIATION_OFFICER', 'SUPER_ADMIN']
        && data.active is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidAuditLog(data, auditId) {
      return data.keys().hasAll(['id', 'actorUid', 'actorRole', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorRole', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && data.id is string && data.id == auditId && data.id.size() <= 128
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.actorRole in ['USER', 'COMPLIANCE_ADMIN', 'RECONCILIATION_OFFICER', 'SUPER_ADMIN', 'SYSTEM']
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 100
        && data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 60
        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 320
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidPaymentAccount(data, accountId) {
      return data.keys().hasAll(['id', 'userId', 'accountType', 'holderName', 'accountLabel', 'isPrimary', 'simulatedMode', 'verificationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'accountType', 'holderName', 'accountLabel', 'upiApp', 'upiVpaMasked', 'bankName', 'ifscCode', 'accountNumberMasked', 'accountLast4', 'isPrimary', 'simulatedMode', 'verificationStatus', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == accountId && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.accountType in ['UPI_VPA', 'BANK_ACCOUNT']
        && data.holderName is string && data.holderName.size() >= 1 && data.holderName.size() <= 120
        && data.accountLabel is string && data.accountLabel.size() >= 1 && data.accountLabel.size() <= 80
        && data.isPrimary is bool
        && data.simulatedMode is bool && data.simulatedMode == true
        && data.verificationStatus in ['SIMULATED_VERIFIED', 'PENDING_PARTNER_VERIFICATION']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (
          (data.accountType == 'UPI_VPA'
            && ('upiApp' in data) && data.upiApp in ['GPAY', 'PHONEPE', 'PAYTM', 'BHIM', 'AMAZON_PAY', 'OTHER_UPI']
            && ('upiVpaMasked' in data) && data.upiVpaMasked is string && data.upiVpaMasked.size() >= 5 && data.upiVpaMasked.size() <= 80
            && !('bankName' in data) && !('ifscCode' in data) && !('accountNumberMasked' in data) && !('accountLast4' in data))
          ||
          (data.accountType == 'BANK_ACCOUNT'
            && ('bankName' in data) && data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 80
            && ('ifscCode' in data) && data.ifscCode is string && data.ifscCode.size() == 11 && data.ifscCode.matches('^[A-Z]{4}0[A-Z0-9]{6}$')
            && ('accountNumberMasked' in data) && data.accountNumberMasked is string && data.accountNumberMasked.size() >= 6 && data.accountNumberMasked.size() <= 32
            && ('accountLast4' in data) && data.accountLast4 is string && data.accountLast4.size() == 4 && data.accountLast4.matches('^[0-9]{4}$')
            && !('upiApp' in data) && !('upiVpaMasked' in data))
        );
    }

    // 1. Users (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId) && incoming().accountStatus == 'ACTIVE';
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 2. Profiles (PII isolated)
    match /profiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(userId) && isOwner(userId) && isValidProfile(incoming(), userId);
      allow update: if isValidId(userId) && isValidProfile(incoming(), userId) && incoming().userId == existing().userId && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneMasked', 'city', 'state', 'preferredStartInr', 'preferredIncrementInr', 'preferredUpiApp', 'preferredUpiVpaMasked', 'kycSimulationStatus', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 3. Challenges (Terminal state locking enforced)
    match /challenges/{challengeId} {
      allow get: if isValidId(challengeId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(challengeId) && isVerified()
        && isValidChallenge(incoming(), challengeId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'ACTIVE'
        && incoming().locked == false
        && incoming().completedDays == 0
        && incoming().totalSavedInr == 0;
      allow update: if isValidId(challengeId) && isVerified()
        && isValidChallenge(incoming(), challengeId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && existing().locked == false
        && existing().status == 'ACTIVE'
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && (
            // Action: Daily deposit progress
            (incoming().status in ['ACTIVE', 'COMPLETED'] && incoming().diff(existing()).affectedKeys().hasOnly(['totalSavedInr', 'completedDays', 'status', 'locked', 'nextDueDate', 'updatedAt'])) ||
            // Action: Missed deadline failure lock
            (incoming().status == 'FAILED' && incoming().locked == true && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'locked', 'failedReason', 'updatedAt']))
          ))
        );
      allow delete: if false;
    }

    // 4. Daily Contributions (Parent challenge must exist and belong to user)
    match /dailyContributions/{contributionId} {
      allow get: if isValidId(contributionId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(contributionId) && isVerified()
        && isValidDailyContribution(incoming(), contributionId)
        && incoming().userId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId))
        && getAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 5. Streaks
    match /streaks/{streakId} {
      allow get: if isValidId(streakId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(streakId) && isVerified()
        && isValidStreak(incoming(), streakId)
        && incoming().userId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId));
      allow update: if isValidId(streakId) && isVerified()
        && isValidStreak(incoming(), streakId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().challengeId == existing().challengeId
        && (isAdmin() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['currentStreak', 'longestStreak', 'lastContributionDate', 'streakBroken', 'updatedAt'])));
      allow delete: if false;
    }

    // 6. Transactions (Append-only for users, reconciliation updates by admin only)
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(transactionId) && isVerified()
        && isValidTransaction(incoming(), transactionId)
        && (incoming().userId == request.auth.uid || isAdmin())
        && existsAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId));
      allow update: if isValidId(transactionId) && isAdmin()
        && isValidTransaction(incoming(), transactionId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().amountInr == existing().amountInr
        && incoming().diff(existing()).affectedKeys().hasOnly(['reconciliationStatus']);
      allow delete: if false;
    }

    // 7. Restricted Funds Ledger (Non-confiscatable, user-owned; admin reconcile/partner-approved settle only)
    match /restrictedFundsLedger/{ledgerId} {
      allow get: if isValidId(ledgerId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(ledgerId) && isVerified()
        && isValidRestrictedLedger(incoming(), ledgerId)
        && incoming().userId == request.auth.uid
        && incoming().ownershipStatus == 'USER_OWNED_RESTRICTED'
        && incoming().legalPartnerReviewStatus == 'PENDING_LEGAL_PARTNER_REVIEW'
        && existsAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId));
      allow update: if isValidId(ledgerId) && isAdmin()
        && isValidRestrictedLedger(incoming(), ledgerId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().challengeId == existing().challengeId
        && incoming().principalBalanceInr == existing().principalBalanceInr
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['reconciliationNote', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['ownershipStatus', 'legalPartnerReviewStatus', 'reconciliationNote', 'updatedAt'])
        );
      allow delete: if false;
    }

    // 8. Settlement Requests (Users can read & initiate pending request; only Admin with partner ref can approve/settle)
    match /settlementRequests/{settlementId} {
      allow get: if isValidId(settlementId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(settlementId) && isVerified()
        && isValidSettlementRequest(incoming(), settlementId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'PENDING_LEGAL_PARTNER_REVIEW'
        && existsAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId));
      allow update: if isValidId(settlementId) && isAdmin()
        && isValidSettlementRequest(incoming(), settlementId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().amountInr == existing().amountInr
        && incoming().createdAt == existing().createdAt
        && existing().status != 'SETTLED_REFUNDED'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'legalApprovalRef', 'partnerBankRef', 'transactionRef', 'approvedBy', 'settledAt']);
      allow delete: if false;
    }

    // 9. Reward Records (One-time illustrative bonus on completion)
    match /rewardRecords/{rewardId} {
      allow get: if isValidId(rewardId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(rewardId) && isVerified()
        && isValidRewardRecord(incoming(), rewardId)
        && incoming().userId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/challenges/$(incoming().challengeId));
      allow update, delete: if false;
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId) && isVerified()
        && isValidNotification(incoming(), notificationId)
        && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isValidId(notificationId) && isVerified()
        && isValidNotification(incoming(), notificationId)
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // 11. Admin Users (Strictly admin-managed)
    match /adminUsers/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminUid) && isAdmin() && isValidAdminUser(incoming(), adminUid);
      allow delete: if false;
    }

    // 12. Audit Logs (Append-only, strictly immutable)
    match /auditLogs/{auditId} {
      allow get: if isValidId(auditId) && isVerified() && (existing().actorUid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerified() && resource.data.actorUid == request.auth.uid);
      allow create: if isValidId(auditId) && isVerified()
        && isValidAuditLog(incoming(), auditId)
        && (incoming().actorUid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // 13. Registered Payment Accounts (Masked UPI VPAs & Bank Accounts, strict PII owner/admin isolation)
    match /paymentAccounts/{accountId} {
      allow get: if isValidId(accountId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(accountId) && isVerified()
        && isValidPaymentAccount(incoming(), accountId)
        && incoming().userId == request.auth.uid;
      allow update: if isValidId(accountId) && isVerified()
        && isValidPaymentAccount(incoming(), accountId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().accountType == existing().accountType
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['accountLabel', 'isPrimary', 'updatedAt']))
        );
      allow delete: if isValidId(accountId) && isVerified() && existing().userId == request.auth.uid;
    }
  }
}
